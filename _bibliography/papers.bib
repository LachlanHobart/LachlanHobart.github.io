@article{hobartInitialConditionsInitial2026,
  title = {The Initial Conditions and Initial Mass Functions of {{Alpha Persei}}, {{Pleiades}} and {{Praesepe}}},
  author = {Hobart, L. and Baumgardt, H. and Sweet, S.},
  year = 2026,
  month = jul,
  journal = {Publications of the Astronomical Society of Australia},
  pages = {1--27},
  issn = {1323-3580, 1448-6083},
  doi = {10.1017/pasa.2026.10236},
  urldate = {2026-08-03},
  abstract = {Abstract                            We have determined the initial mass function (IMF) and structural properties of the open clusters Alpha Persei, Pleiades and Praesepe using               Gaia               DR3 proper motions, parallaxes and photometry. Cluster members were identified using primarily               Gaia               astrometric observations, supplemented with near-infrared UKIDSS and optical HIPPARCOS survey data with stellar masses down to 0.10 - 0.17M               {$\odot$}               . We measure and correct for unresolved binaries in each cluster using photometry and Monte Carlo simulations in a Bayesian framework, finding present-day unresolved binary fractions between (20.0 \textpm{} 0.8)\% and (23.8 \textpm{} 1.2)\%. Through a novel approach that combines               N               -body simulations with machine learning emulators and Hamiltonian Monte Carlo algorithms, we have also determined the most probable initial number of stars, binary fraction, half-mass radius and mass function under the assumption that early gas removal does not significantly influence the subsequent cluster evolution. We find a best-fitting initial mass function described by a three-stage broken power-law distribution with break masses in the ranges 0.24--0.50M               {$\odot$}               and 0.91--1.20M               {$\odot$}               and average slopes of {$\alpha$}               med               = 1.72 \textpm{} 0.09 and {$\alpha$}               high               = 2.98 \textpm{} 0.22. While the low-mass slope remains sensitive to the adopted mass--luminosity relation, this IMF reproduces the present-day clusters well once their dynamical evolution is taken into account. We find evidence of some scatter in the high mass IMF between the individual clusters, as described by the measured dispersions in mass function slopes of {$\sigma$}               high               = 0.29 \textpm{} 0.16, whereas the intermediate mass slope shows no significant variation with {$\sigma$}               med               = 0.00 \textpm{} 0.14. Our findings provide additional evidence for a (compared to a Salpeter MF) top-light IMF and a cluster-to-cluster variation of the IMF. They therefore provide constraints on the universality of the IMF and its dependence on environmental conditions.},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  langid = {english},
